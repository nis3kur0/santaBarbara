    id_bonificacion INTEGER PRIMARY KEY AUTOINCREMENT,
    id_empleado INTEGER NOT NULL,
    tipo TEXT NOT NULL, -- Antigüedad, productividad, especial, etc.
    monto REAL NOT NULL, -- Monto fijo o porcentaje calculado
    fecha_aplicacion DATE NOT NULL, -- Fecha de aplicación
    descripcion TEXT, -- Detalles de la bonificación
    es_recurrente INTEGER DEFAULT 0, -- 0 = FALSE, 1 = TRUE (SQLite no tiene BOOLEAN)
    FOREIGN KEY (id_empleado) REFERENCES empleados(ID)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
